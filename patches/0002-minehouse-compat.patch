+        &mut self.health_hud
+    }
+    pub(in crate::game) fn native_client_state(&self) -> Option<NativeClientState> {
+        if !self.native_window() {
+            return None;
+        }
+        let (w, h) = self.gui_size();
+        let covered = self.title.is_some() || self.screen_over_playing() || self.remote_screen_up();
+        Some(NativeClientState {
+            focused: self.focused,
+            gui_hidden: self.ui.hide_gui,
+            gui_size: [w, h],
+            server_address: self.remote.as_ref().map(|r| r.session.address.clone()),
+            logged_in: self.remote.as_ref().is_some_and(|r| r.logged_in),
+            yaw: self.yaw,
+            pitch: self.pitch,
+            screen: match self.screen {
+                _ if covered => NativeScreenKind::Other,
+                Screen::Playing => NativeScreenKind::Playing,
+                Screen::Chat => NativeScreenKind::Chat,
+                Screen::Dead => NativeScreenKind::Death,
+                _ => NativeScreenKind::Other,
+            },
+            debug_screen: self.debug,
+            world: self.remote.as_ref().filter(|r| r.logged_in).map(|r| {
+                match self.integrated.as_ref() {
+                    Some(server) => NativeWorldId::Singleplayer(server.save_folder.clone()),
+                    None => NativeWorldId::Server(r.session.address.clone()),
+                }
+            }),
+        })
+    }
+    pub(in crate::game) fn native_client_entities(&self) -> Vec<NativeClientEntity> {
+        if !self.native_window() || self.remote.is_none() {
+            return Vec::new();
+        }
+        self.mobs
+            .iter()
+            .filter(|m| !m.removed)
+            .map(|m| {
+                let b = m.bounds();
+                let (lo, hi) = (b.min_position(), b.max_position());
+                NativeClientEntity {
+                    id: m.id,
+                    player_uuid: self.remote_player_uuid(m.id),
+                    player_name: self.remote_player_name(m.id).map(str::to_owned),
+                    position: [m.position.x, m.position.y, m.position.z],
+                    previous_position: [m.previous.x, m.previous.y, m.previous.z],
+                    bounds: [[lo.x, lo.y, lo.z], [hi.x, hi.y, hi.z]],
+                    height: m.height(),
+                    head_yaw: m.head_yaw,
+                    head_pitch: m.head_pitch,
+                    alive: m.alive(),
+                    invisible: m.invisible || m.has_effect("minecraft:invisibility"),
+                    kind: m.kind.id.to_string(),
+                    yaw: m.yaw,
+                    baby: m.is_baby(),
+                    spectator: m.extra.spectator,
+                    texture: Some(horizon_client::mobs::render::body(m).1)
+                        .filter(|t| !t.is_empty())
+                        .map(Cow::into_owned),
+                }
+            })
+            .collect()
+    }
+    pub(in crate::game) fn native_client_items(&self) -> Vec<NativeClientItem> {
+        if !self.native_window() || self.remote.is_none() {
+            return Vec::new();
+        }
+        self.dropped
+            .iter()
+            .filter(|e| e.stack.count > 0)
+            .map(|e| NativeClientItem {
+                id: e.id,
+                stack: e.stack.clone(),
+                position: [e.position.x, e.position.y, e.position.z],
+                previous_position: [e.previous.x, e.previous.y, e.previous.z],
+            })
+            .collect()
+    }
+}
