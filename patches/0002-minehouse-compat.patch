+    }
+    /// A play packet to the server, as the game sends its own: refused outside play.
+    pub(in crate::game) fn native_send_packet(
+        &mut self,
+        packet: horizon_protocol::packets::play::Serverbound,
+    ) -> Result<(), String> {
+        let remote = self.remote.as_ref().ok_or("not connected")?;
+        if !remote.joined || remote.reconfiguring.is_some() {
+            return Err("not in play".into());
