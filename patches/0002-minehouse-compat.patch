+//! MineHouse: the hook points and host calls MineHouse's mods were written against (Horizon
+//! 9f42064, before the native and wasm mod APIs merged), on top of this Horizon's own. One file,
+//! plus a call at each place the old points fired, so that moving to a newer Horizon only
+//! moves this patch.
+#![allow(dead_code)]
+use super::*;
+use horizon_client::block_entity_render::{BeamShape, beam};
+use horizon_client::gizmos::{self, Gizmos, Line};
+use horizon_client::mesher::Vertex;
+use horizon_client::world_geometry::WorldGeometry;
+use horizon_client::world_primitives::{
+    MAX_BEAM_HEIGHT, PrimitiveShape, WorldPrimitives, text_unit, vertex_color,
+};
+use std::borrow::Cow;
+use std::collections::HashSet;
+use std::sync::Mutex;
+
+/// A mod's row in Options > Mods (`native_mods`).
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct NativeMod {
+    /// Its id: its settings folder and its keys' lines.
+    pub id: String,
+    /// `Name 1.0`.
+    pub title: String,
+    pub description: String,
+    /// Its keys: name, label and default key (`key.keyboard.z`).
+    pub keys: Vec<[String; 3]>,
+}
+
+pub type NativeScreenView<'a> = ScreenView<'a>;
+pub type NativeZoom = mod_api::Zoom;
+pub type NativeMinimap = mod_api::Minimap;
+pub type NativeCamera = mod_api::Camera;
+pub type NativeClock = mod_api::Clock;
+
+/// What covers the world.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum NativeScreenKind {
+    #[default]
+    Playing,
+    Chat,
+    Death,
+    Other,
+}
+
+/// The world this window plays: a save's folder, or a server's address.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub enum NativeWorldId {
+    Singleplayer(String),
+    Server(String),
+}
+
+/// This window's state.
+#[derive(Clone, Debug)]
+pub struct NativeClientState {
+    pub focused: bool,
+    pub gui_hidden: bool,
+    pub gui_size: [f32; 2],
+    pub server_address: Option<String>,
+    pub logged_in: bool,
+    pub yaw: f32,
+    pub pitch: f32,
+    pub screen: NativeScreenKind,
+    pub debug_screen: bool,
+    pub world: Option<NativeWorldId>,
+}
+
+/// A living entity the client knows.
+#[derive(Clone, Debug, Default)]
+pub struct NativeClientEntity {
+    pub id: u32,
+    pub player_uuid: Option<u128>,
+    pub player_name: Option<String>,
+    pub position: [f64; 3],
+    pub previous_position: [f64; 3],
+    pub bounds: [[f64; 3]; 2],
+    pub height: f32,
+    pub head_yaw: f32,
+    pub head_pitch: f32,
+    pub alive: bool,
+    pub invisible: bool,
+    pub kind: String,
+    pub yaw: f32,
+    pub baby: bool,
+    pub spectator: bool,
+    pub texture: Option<String>,
+}
+
+/// A dropped item the client knows.
+#[derive(Clone, Debug)]
+pub struct NativeClientItem {
+    pub id: u32,
+    pub stack: ItemStack,
+    pub position: [f64; 3],
+    pub previous_position: [f64; 3],
+}
+
+/// Blocks drawn in the world (`native_world_submit`): a pose stack from the camera, and the
+/// vertices the drawn blocks leave.
+pub struct NativeWorldDraw {
+    pub camera: [f64; 3],
+    pub partial: f32,
+    pub game_time: i64,
+    pub light: u32,
+    poses: Vec<glam::Mat4>,
+    vertices: Vec<Vertex>,
+}
+
+impl NativeWorldDraw {
+    fn new(camera: [f64; 3], partial: f32, game_time: i64) -> Self {
+        Self {
+            camera,
+            partial,
+            game_time,
+            light: 0xF0_F0,
+            poses: vec![glam::Mat4::IDENTITY],
+            vertices: Vec::new(),
+        }
+    }
+    pub fn push(&mut self) {
+        let top = *self.poses.last().expect("a pose");
+        self.poses.push(top);
+    }
+    pub fn pop(&mut self) {
+        if self.poses.len() > 1 {
+            self.poses.pop();
+        }
+    }
+    pub fn pose(&self) -> glam::Mat4 {
+        *self.poses.last().expect("a pose")
+    }
+    /// Move the pose to the world position `at`: false when it is not finite.
+    pub fn translate_world(&mut self, at: [f64; 3]) -> bool {
+        let offset: [f64; 3] = std::array::from_fn(|i| at[i] - self.camera[i]);
+        if offset.iter().any(|v| !v.is_finite()) {
+            return false;
+        }
+        let top = self.poses.last_mut().expect("a pose");
+        *top *= glam::Mat4::from_translation(glam::DVec3::from_array(offset).as_vec3());
+        true
+    }
+}
+
+/// The ids of the mods the old `native_mods` listed, whose pages are buttons.
+static COMPAT_MODS: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+
+fn compat_mod(id: &str) -> bool {
+    COMPAT_MODS
+        .lock()
+        .unwrap()
+        .as_ref()
+        .is_some_and(|ids| ids.contains(id))
+}
+
+/// The old hook points: MineHouse's mods inject into these.
+impl Game<'_> {
+    /// A key or mouse button went down or up, by its vanilla name (`key.keyboard.z`,
+    /// `key.mouse.left`): keys on any screen, mouse buttons while playing. No repeats.
+    pub(in crate::game) fn native_key(&mut self, key: &str, pressed: bool) {
+        let _ = (key, pressed);
+    }
+    /// Options > Mods lists the native mods: push yours.
+    pub(in crate::game) fn native_mods(&mut self, mods: &mut Vec<NativeMod>) {
+        let _ = mods;
+    }
+    /// The buttons of mod `mod_id`'s settings page: push their labels when it is yours.
+    pub(in crate::game) fn native_settings(&mut self, mod_id: &str, buttons: &mut Vec<String>) {
+        let _ = (mod_id, buttons);
+    }
+    /// Button `button` of mod `mod_id`'s settings page was clicked.
+    pub(in crate::game) fn native_settings_click(&mut self, mod_id: &str, button: usize) {
+        let _ = (mod_id, button);
+    }
+    /// The client commands `native_command` runs, without their slash.
+    pub(in crate::game) fn native_commands(&mut self, commands: &mut Vec<&'static str>) {
+        let _ = commands;
+    }
+    /// Once a frame, in a world or not.
+    pub(in crate::game) fn native_frame(&mut self, elapsed: Duration) {
+        let _ = elapsed;
+    }
+    /// The HUD (not drawn under F1): place a box with `corners.place`.
+    pub(in crate::game) fn native_hud(&mut self, batch: &mut HudBatch, corners: &mut Corners) {
+        let _ = (batch, corners);
+    }
+    /// Wheel steps while playing: set `claimed` to keep them from the hotbar.
+    pub(in crate::game) fn native_wheel(&mut self, steps: f32, claimed: &mut bool) {
+        let _ = (steps, claimed);
+    }
+    /// Lines, boxes, beams and text in the world, this frame.
+    pub(in crate::game) fn native_world_primitives(
+        &self,
+        partial: f32,
+        camera: [f64; 3],
+        primitives: &mut WorldPrimitives,
+    ) {
+        let _ = (partial, camera, primitives);
+    }
+    /// A decoded play packet from the server, just before the game handles it.
+    pub(in crate::game) fn native_client_play_packet(
+        &mut self,
+        packet: &horizon_protocol::packets::play::Clientbound,
+    ) {
+        let _ = packet;
+    }
+    /// A chat line from the server about to show: replace `message` to change it. `sender` is
+    /// the player's UUID, 0 for system lines; `overlay` is an action bar line.
+    pub(in crate::game) fn native_chat_received(
+        &mut self,
+        overlay: bool,
+        sender: u128,
+        message: &mut horizon_client::text::Text,
+    ) {
+        let _ = (overlay, sender, message);
+    }
+    /// Blocks drawn in the world, this frame (`native_world_draw_block`).
+    pub(in crate::game) fn native_world_submit(&self, draw: &mut NativeWorldDraw) {
+        let _ = draw;
+    }
+}
+
+/// Where the old points fire, called from this Horizon's own code.
+impl Game<'_> {
+    /// A window or control socket key, for `native_key`.
+    pub(in crate::game) fn mh_key_event(&mut self, key: Option<&str>, action: mod_api::KeyAction) {
+        let Some(key) = key else {
+            return;
+        };
+        match action {
+            mod_api::KeyAction::Press => self.native_key(key, true),
+            mod_api::KeyAction::Release => self.native_key(key, false),
+            mod_api::KeyAction::Repeat => {}
+        }
+    }
+    /// A mouse button while playing, for `native_key`.
+    pub(in crate::game) fn mh_mouse_event(&mut self, button: MouseButton, pressed: bool) {
+        let name = keybinds::mouse_name(button);
+        self.native_key(&name, pressed);
+    }
+    /// `native_commands`' names, as this Horizon's client commands.
+    pub(in crate::game) fn mh_commands(&mut self, commands: &mut Vec<mod_api::Command>) {
+        let mut names = Vec::new();
+        self.native_commands(&mut names);
+        for name in names {
+            commands.push(mod_api::Command::new(name));
+        }
+    }
+    /// Gameplay scrolling, for `native_wheel`.
+    pub(in crate::game) fn mh_wheel(&mut self, accumulated: [i32; 2], canceled: &mut bool) {
+        if accumulated[1] == 0 {
+            return;
+        }
+        let mut claimed = false;
+        self.native_wheel(accumulated[1] as f32, &mut claimed);
+        if claimed {
+            *canceled = true;
+        }
+    }
+    /// Options > Mods: the rows `native_mods` lists, their keys and buttons.
+    pub(in crate::game) fn mh_list_mods(&mut self) {
+        let mut mods = Vec::new();
+        self.native_mods(&mut mods);
+        *COMPAT_MODS.lock().unwrap() = Some(mods.iter().map(|m| m.id.clone()).collect());
+        self.settings
+            .mods
+            .installed
+            .retain(|row| !mods.iter().any(|m| m.id == row.id));
+        for m in mods {
+            let mappings = m
+                .keys
+                .iter()
+                .map(|[id, label, key]| KeyMapping {
+                    id: id.clone(),
+                    label: label.clone(),
+                    key: key.clone(),
+                    modifiers: 0,
+                    context: Default::default(),
+                    category: String::new(),
+                })
+                .collect();
+            let settings = self.mh_buttons(&m.id);
+            self.settings.mods.installed.push(Installed {
+                id: m.id,
+                title: m.title,
+                description: m.description,
+                problem: None,
+                dev: false,
+                native: Some(NativePage { mappings, settings }),
+            });
+        }
+    }
+    /// A compat mod's buttons as one-option choices: a click on one is the button's click.
+    fn mh_buttons(&mut self, mod_id: &str) -> Vec<NativeSetting> {
+        let mut buttons = Vec::new();
+        self.native_settings(mod_id, &mut buttons);
+        buttons
+            .into_iter()
+            .enumerate()
+            .map(|(i, label)| NativeSetting {
+                key: format!("button.{i}"),
+                label: label.clone(),
+                tooltip: None,
+                value: NativeSettingValue::Choice {
+                    options: vec![label],
+                    index: 0,
+                },
+            })
+            .collect()
+    }
+    /// Setting `j` of row `i` changed: a compat mod's button click. True when it was one.
+    pub(in crate::game) fn mh_setting_event(&mut self, i: usize, j: usize) -> bool {
+        let Some(id) = self.settings.mods.installed.get(i).map(|m| m.id.clone()) else {
+            return false;
+        };
+        if !compat_mod(&id) {
+            return false;
+        }
+        self.native_settings_click(&id, j);
+        self.mh_settings_refresh(i);
+        true
+    }
+    /// Row `i`'s page opened or was clicked: a compat mod's labels asked again. True when it
+    /// was one.
+    pub(in crate::game) fn mh_settings_refresh(&mut self, i: usize) -> bool {
+        let Some(id) = self.settings.mods.installed.get(i).map(|m| m.id.clone()) else {
+            return false;
+        };
+        if !compat_mod(&id) {
+            return false;
+        }
+        let settings = self.mh_buttons(&id);
+        if let Some(page) = self
+            .settings
+            .mods
+            .installed
+            .get_mut(i)
+            .and_then(|m| m.native.as_mut())
+        {
+            page.settings = settings;
+        }
+        true
+    }
+    /// The world draws: the old points' primitives and blocks.
+    pub(in crate::game) fn mh_world(
+        &mut self,
+        camera: [f64; 3],
+        alpha: f64,
+        draw: &mut WorldGeometry,
+        entities: &mut Vec<Vertex>,
+    ) {
+        let mut blocks = NativeWorldDraw::new(camera, alpha as f32, self.world.game_time);
+        self.native_world_submit(&mut blocks);
+        entities.extend(blocks.vertices);
+        let mut primitives = WorldPrimitives::default();
+        self.native_world_primitives(alpha as f32, camera, &mut primitives);
+        if primitives.is_empty() {
+            return;
+        }
+        let (quads, lines, view) = draw.raw();
+        self.mh_tessellate(&primitives, glam::DVec3::from_array(camera), alpha, view, quads, lines);
+    }
+    /// Draws block `block` in the state with `properties` under `draw`'s pose. False for an
+    /// unknown block or property.
+    pub(in crate::game) fn native_world_draw_block(
+        &self,
+        draw: &mut NativeWorldDraw,
+        block: &str,
+        properties: &[(&str, &str)],
+    ) -> bool {
+        let registry = &self.pack.assets.registry;
+        let Some(mut state) = registry
+            .default_state(block)
+            .and_then(|id| registry.state(id))
+            .cloned()
+        else {
+            return false;
+        };
+        for (key, value) in properties {
+            match state.properties.get_mut(*key) {
+                Some(v) => *v = (*value).to_owned(),
+                None => return false,
+            }
+        }
+        let Some(id) = registry.id(&state) else {
+            return false;
+        };
+        let pose = draw.pose();
+        self.block_model_vertices(id, 42, pose, draw.light, true, &mut draw.vertices);
+        true
+    }
+    fn mh_tessellate(
+        &mut self,
+        primitives: &WorldPrimitives,
+        camera: glam::DVec3,
+        alpha: f64,
+        view: glam::Mat4,
+        out_quads: &mut [Vec<Vertex>; 2],
+        out_lines: &mut [Vec<[f32; 8]>; 2],
+    ) {
+        let atlas = &self.gui.atlas;
+        let white = horizon_client::gfx::lightning::white_uv(&atlas.font.white());
+        let beam_sprite = atlas.sprites.get("entity/beacon/beacon_beam").copied();
+        let time = self.world.game_time.rem_euclid(40) as f32 + alpha as f32;
+        let relative = |p: [f64; 3]| (glam::DVec3::from_array(p) - camera).as_vec3();
+        let mut lines: [Vec<Line>; 2] = Default::default();
+        let mut texts = Vec::new();
+        for primitive in primitives.iter() {
+            let through = usize::from(primitive.through_walls);
+            let quads = &mut out_quads[through];
+            match &primitive.shape {
+                PrimitiveShape::Line {
+                    from,
+                    to,
+                    color,
+                    width,
+                } if finite(from) && finite(to) && width.is_finite() => {
+                    lines[through].push(Line {
+                        start: *from,
+                        end: *to,
+                        color: *color,
+                        width: *width,
+                    });
+                }
+                PrimitiveShape::BoxOutline {
+                    min,
+                    max,
+                    color,
+                    width,
+                } if finite(min) && finite(max) && width.is_finite() => {
+                    let mut edges = Gizmos::default();
+                    edges.cuboid(*min, *max, *color, *width);
+                    lines[through].extend(edges.lines);
+                }
+                PrimitiveShape::FilledBox { min, max, color } if finite(min) && finite(max) => {
+                    let color = vertex_color(*color, 255);
+                    for quad in gizmos::cuboid_fill_quads(*min, *max) {
+                        quads.extend(quad.map(|corner| plain(relative(corner), white, color)));
+                    }
+                }
+                PrimitiveShape::Beam {
+                    base,
+                    height,
+                    color,
+                } if finite(base) => {
+                    let Some(sprite) = beam_sprite else {
+                        continue;
+                    };
+                    let corner = relative(*base) - glam::Vec3::new(0.5, 0.0, 0.5);
+                    let start = quads.len();
+                    beam(
+                        glam::Mat4::from_translation(corner),
+                        BeamShape {
+                            scale: 1.0,
+                            time,
+                            start: 0,
+                            height: (*height).min(MAX_BEAM_HEIGHT) as i32,
+                            color: color & 0xFF_FFFF,
+                            solid_radius: 0.2,
+                            glow_radius: 0.25,
+                        },
+                        sprite,
+                        quads,
+                    );
+                    for v in &mut quads[start..] {
+                        let a = (v.color >> 24) * (color >> 24) / 255;
+                        v.color = a << 24 | v.color & 0xFF_FFFF;
+                    }
+                }
+                PrimitiveShape::Text {
+                    at,
+                    text,
+                    color,
+                    scale,
+                    scale_with_distance,
+                    background,
+                } if finite(at) => {
+                    let o = glam::DVec3::from_array(*at) - camera;
+                    let unit = text_unit(*scale, *scale_with_distance, o.length());
+                    if unit > 0.0 {
+                        texts.push((through, o, text.clone(), *color, unit, *background));
+                    }
+                }
+                _ => {}
+            }
+        }
+        for (through, o, text, color, unit, background) in texts {
+            let line = [(
+                Text::colored(text, color & 0xFF_FFFF),
+                f64::from(unit * 4.5),
+            )];
+            let patches = self.name_tag_quads(
+                o,
+                &line,
+                color >> 24,
+                background,
+                0,
+                0,
+                unit,
+                &mut out_quads[through],
+            );
+            self.map_patches.extend(patches);
+        }
+        let at = camera.to_array();
+        for (i, lines) in lines.iter().enumerate() {
+            out_lines[i].extend(gizmos::camera_relative(lines, at, view));
+        }
+    }
+}
+
+fn finite(p: &[f64; 3]) -> bool {
+    p.iter().all(|v| v.is_finite())
+}
+
+fn plain(pos: glam::Vec3, white: [f32; 2], color: u32) -> Vertex {
+    Vertex {
+        pos: pos.to_array(),
+        uv: white,
+        layer: 0,
+        color,
+        light: 0,
+        normal: [0; 4],
+        glint_uv: [0.0, 0.0],
+    }
+}
